# Copy to .env.test.write, keep it untracked, and replace every REPLACE_* value.
# This file contains references and public addresses only; never put key bytes here.

SOLANA_RPC_URL=https://REPLACE_WITH_RPC_ENDPOINT
# Some providers expose Solana PubSub separately. Alchemy uses:
# wss://solana-mainnet.streaming.alchemy.com/v2/REPLACE_WITH_THE_SAME_API_KEY
SOLANA_WS_URL=wss://REPLACE_WITH_SOLANA_PUBSUB_ENDPOINT
SOLANA_COMMITMENT=confirmed
# Alchemy meters throughput per account (all apps/processes sharing the key) over
# a 10-second rolling window. 240 leaves 20% headroom on the 300 CU/s free tier;
# lower it whenever other applications use the same account.
SOLANA_RPC_MAX_CU_PER_SECOND=240

WALLET_SIGNER=file
WALLET_KEYPAIR_PATH=/etc/clmm-executor/wallet.json
WALLET_PUBKEY=REPLACE_WITH_WALLET_PUBLIC_KEY
# Keep false on localnet/devnet. Mainnet requires a deliberate true after the Arm B gate.
FILE_SIGNER_ALLOW_MAINNET=false

LIVE_POOL=REPLACE_WITH_METEORA_POOL
POOL_ALLOWLIST=REPLACE_WITH_METEORA_POOL
MINT_ALLOWLIST=REPLACE_WITH_TOKEN_X_MINT,REPLACE_WITH_TOKEN_Y_MINT

# First-position account initialization can consume about 0.22 SOL of policy budget.
# Reassess these caps for the selected pool and fund only the approved dust budget.
MAX_SOL_PER_TX=0.23
MAX_SOL_PER_RUN=0.25
MAX_SLIPPAGE_BPS=50
MAX_ACTIVE_BIN_SLIPPAGE_BINS=2
MAX_PRIORITY_FEE_LAMPORTS=0

JITO_ENABLED=false
JITO_TIP_LAMPORTS=0
# When JITO_ENABLED=true the refresh_bundle path submits one atomic bundle to
# the Block Engine. JITO_BLOCK_ENGINE_URL and JITO_TIP_ACCOUNT are then
# required; the tip account must appear in JITO_TIP_ACCOUNTS (defaults to the
# canonical mainnet tip list) and JITO_TIP_LAMPORTS must fit
# MAX_PRIORITY_FEE_LAMPORTS.
#JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
#JITO_TIP_ACCOUNT=96gYZGLnJYVFmbjzopPSU6QiEV5fGqZNyN9nmNhvrZU5
#JITO_TIP_ACCOUNTS=96gYZGLnJYVFmbjzopPSU6QiEV5fGqZNyN9nmNhvrZU5,HFqU5x63VTqvQss8hp11i4wVV8bD44PvwucfZ2bU7gRe
# The Jupiter aggregator route (swap with pool:null) is ON STAND-BY: no handler
# wires it and the executor rejects pool:null. These keys still load so the
# route can be re-enabled once its router binding is verified against a real
# captured mainnet route; leaving them unset is fine.
JUPITER_BASE_URL=https://lite-api.jup.ag/swap/v1
JUPITER_PROGRAM_ALLOWLIST=JUP6LkbZbjS1jKKwapdHNy74zcZ3tLUZoi5QNyVTaV4
SWAP_STREAM_PATH=logs/swaps-m4.jsonl
EXECUTOR_LOG_DIR=logs
DRY_RUN=false

LIVE_WRITE_CONFIRM=yes
LIVE_RUN_ID=REPLACE_WITH_UNIQUE_RUN_ID
LIVE_REQUEST_TIMEOUT_MS=90000
LIVE_DEPOSIT_SIDE=bid
LIVE_DEPOSIT_BIN_OFFSETS=-2,-1
# Decimal amounts in quote-token units for bid, base-token units for ask.
# The lifecycle deposits this vector twice; fund only that total plus a small buffer.
LIVE_DEPOSIT_AMOUNTS=0.01,0.01
LIVE_MAX_ACTIVE_BIN_SLIPPAGE=0
LIVE_WEIGHT_TOLERANCE_BPS=100

# --- Read-only swap capture (tools/capture-swaps.sh) ---------------------
# Copy this file to .env.capture and set DRY_RUN=true, the pool/mints to
# calibrate, and a dedicated append-only stream path. A capture needs no
# keypair: WALLET_PUBKEY is the audit pin and nothing signs. The MAX_* limits
# are still required by config validation; zeros are fine.
#   SWAP_STREAM_PATH=logs/capture/swaps-<pool>.jsonl
#   EXECUTOR_LOG_DIR=logs/capture
#   MAX_SOL_PER_TX=0 / MAX_SOL_PER_RUN=0 / MAX_PRIORITY_FEE_LAMPORTS=0
