# Copy to .env.test.write, keep it untracked, and replace every REPLACE_* value.
# This file contains references and public addresses only; never put key bytes here.

SOLANA_RPC_URL=https://REPLACE_WITH_RPC_ENDPOINT
SOLANA_COMMITMENT=confirmed
SOLANA_RPC_MAX_CU_PER_SECOND=240

WALLET_SIGNER=file
WALLET_KEYPAIR_PATH=/etc/clmm-executor/wallet.json
WALLET_PUBKEY=REPLACE_WITH_WALLET_PUBLIC_KEY
# Keep false on localnet/devnet. Mainnet requires a deliberate true after the Arm B gate.
FILE_SIGNER_ALLOW_MAINNET=false

LIVE_POOL=REPLACE_WITH_METEORA_POOL
POOL_ALLOWLIST=REPLACE_WITH_METEORA_POOL
MINT_ALLOWLIST=REPLACE_WITH_TOKEN_X_MINT,REPLACE_WITH_TOKEN_Y_MINT

# First-position account initialization can consume about 0.22 SOL of policy budget.
# Reassess these caps for the selected pool and fund only the approved dust budget.
MAX_SOL_PER_TX=0.23
MAX_SOL_PER_RUN=0.25
MAX_SLIPPAGE_BPS=50
MAX_ACTIVE_BIN_SLIPPAGE_BINS=0
MAX_PRIORITY_FEE_LAMPORTS=0

JITO_ENABLED=false
JITO_TIP_LAMPORTS=0
SWAP_STREAM_PATH=logs/swaps-m4.jsonl
EXECUTOR_LOG_DIR=logs
DRY_RUN=false

LIVE_WRITE_CONFIRM=yes
LIVE_RUN_ID=REPLACE_WITH_UNIQUE_RUN_ID
LIVE_REQUEST_TIMEOUT_MS=90000
LIVE_DEPOSIT_SIDE=bid
LIVE_DEPOSIT_BIN_OFFSETS=-2,-1
# Decimal amounts in quote-token units for bid, base-token units for ask.
# The lifecycle deposits this vector twice; fund only that total plus a small buffer.
LIVE_DEPOSIT_AMOUNTS=0.01,0.01
LIVE_MAX_ACTIVE_BIN_SLIPPAGE=0
LIVE_WEIGHT_TOLERANCE_BPS=100
